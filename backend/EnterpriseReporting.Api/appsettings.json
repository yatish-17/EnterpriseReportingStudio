{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Issuer": "EnterpriseReportingStudio",
    "Audience": "EnterpriseReportingStudio"
  },
  "Database": {
    "Name": "EnterpriseReportingDb",
    "InitializeOnStartup": false,
    "ConnectionTimeoutSeconds": 5,
    "CommandTimeoutSeconds": 3,
    "HealthCheckTimeoutSeconds": 10
  }
}
