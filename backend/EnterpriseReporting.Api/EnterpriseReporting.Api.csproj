<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>EnterpriseReportingStudio.Api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <ProjectReference Include="..\EnterpriseReporting.Application\EnterpriseReporting.Application.csproj" />
    <ProjectReference Include="..\EnterpriseReporting.Infrastructure\EnterpriseReporting.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\database\EnterpriseReportingStudioWorkspace.dacpac">
      <Link>database\EnterpriseReportingStudioWorkspace.dacpac</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <FrontendProjectDirectory>$(MSBuildProjectDirectory)\..\..\frontend</FrontendProjectDirectory>
  </PropertyGroup>

  <Target Name="BuildFrontendForPublishing" BeforeTargets="_PublishBuildAlternative">
    <Exec WorkingDirectory="$(FrontendProjectDirectory)" Command="npm run build" />
  </Target>

  <Target Name="CopyFrontendToPublishDirectory" AfterTargets="Publish">
    <ItemGroup>
      <FrontendDistribution Include="$(FrontendProjectDirectory)\dist\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)wwwroot" />
    <Copy
      SourceFiles="@(FrontendDistribution)"
      DestinationFiles="@(FrontendDistribution->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
